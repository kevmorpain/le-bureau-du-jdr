{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "le-bureau-du-jdr",
  "main": "./.output/server/index.mjs",
  "compatibility_date": "2025-12-27",
  "assets": {
    "directory": "./.output/public/",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_id": "5f5feb01-abe5-48e4-bcac-7340605b2ab7",
      // Nom hérité de NuxtHub : la D1 de prod y trace les migrations déjà appliquées,
      // le renommer les ferait toutes rejouer.
      "migrations_table": "_hub_migrations",
      "migrations_dir": "server/db/migrations/"
    }
  ],
  // Portraits de personnage (et autres médias à venir : la séparation se fait par
  // préfixe de clé, pas par bucket). Consommé via `useBinding('BLOB')`.
  "r2_buckets": [
    {
      "binding": "BLOB",
      "bucket_name": "le-bureau-du-jdr-media"
    }
  ]
}