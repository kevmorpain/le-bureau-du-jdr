{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "le-bureau-du-jdr",
  "main": "./.output/server/index.mjs",
  "compatibility_date": "2025-12-27",
  "assets": {
    "directory": "./.output/public/",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_id": "5f5feb01-abe5-48e4-bcac-7340605b2ab7",
      "migrations_table": "_hub_migrations",
      "migrations_dir": ".output/server/db/migrations/"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "KV",
      "id": "c00d70edde834c9998ef99d0db30d9e8"
    }
  ],
  // Portraits de personnage (et autres médias à venir : la séparation se fait par
  // préfixe de clé, pas par bucket). Consommé via `hub:blob` (driver cloudflare-r2).
  "r2_buckets": [
    {
      "binding": "BLOB",
      "bucket_name": "le-bureau-du-jdr-media"
    }
  ]
}